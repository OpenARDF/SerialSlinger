# Copy this file to keystore.properties and replace the placeholder values.
# The real keystore.properties file is ignored by git.
storeFile=/Users/yourname/.android/keystores/SerialSlinger-upload.jks
storePassword=change-me
keyAlias=serialslinger-upload
keyPassword=change-me
# Copy the SHA-256 fingerprint shown by Play Console for the existing upload certificate.
certificateSha256=AA:BB:CC:DD
